{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Persistence": {
    "DefaultProvider": "efcore",
    "Providers": {
      "EfCore": {
        "Enabled": true,
        "Driver": "sqlite",
        "Dialect": "SQLite",
        "ConnectionString": "Data Source=filoroch-template.db"
      },
      "NHibernate": {
        "Enabled": false,
        "Driver": "sqlite",
        "Dialect": "SQLite",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__"
      },
      "Dapper": {
        "Enabled": false,
        "Driver": "sqlite",
        "Dialect": "SQLite",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__"
      },
      "Mongo": {
        "Enabled": false,
        "Driver": "mongodb",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__",
        "Database": "Template"
      }
    }
  },
  "Jwt": {
    "Issuer": "Filoroch.Template",
    "Audience": "Filoroch.Template.Api",
    "SigningKey": "this-is-a-very-secure-minimum-32-character-key!!",
    "AccessTokenMinutes": 30,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
