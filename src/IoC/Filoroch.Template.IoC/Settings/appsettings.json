{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "DefaultProvider": "__TEMPLATE_DEFAULT_PROVIDER__",
    "SelectedProviders": "__TEMPLATE_SELECTED_PROVIDERS__",
    "SelectedDrivers": "__TEMPLATE_SELECTED_DRIVERS__",
    "Providers": {
      "EfCore": {
        "Enabled": true,
        "Driver": "__TEMPLATE_DEFAULT_DRIVER__",
        "Dialect": "SQLite",
        "ConnectionString": "Data Source=filoroch-template.db"
      },
      "NHibernate": {
        "Enabled": false,
        "Driver": "Sqlite",
        "Dialect": "SQLite",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__"
      },
      "Dapper": {
        "Enabled": false,
        "Driver": "Sqlite",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__"
      },
      "Mongo": {
        "Enabled": false,
        "Driver": "Mongodb",
        "ConnectionString": "__SET_VIA_DOTNET_USER_SECRETS__",
        "Database": "Template"
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Filoroch.Template",
    "Endpoint": "http://localhost:4317"
  },
  "Jwt": {
    "Issuer": "Filoroch.Template",
    "Audience": "Filoroch.Template.Api",
    "SigningKey": "__SET_VIA_DOTNET_USER_SECRETS__",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Entrypoints": {
    "Api": {
      "Name": "Filoroch.Template API",
      "Urls": [
        "http://localhost:5196"
      ]
    }
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Template API",
    "Description": "API base do template reutiliz\u00E1vel",
    "Version": "v1",
    "RoutePrefix": "swagger",
    "JsonRoute": "swagger/{documentName}/swagger.json"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
