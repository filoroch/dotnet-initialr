using MongoDB.Bson;
using MongoDB.Bson.Serialization;
using {{RootNamespace}}.Domain.{{Context}}.Entities;

namespace {{RootNamespace}}.Infra.{{Context}}.Mappings;

public static class {{Entity}}MongoMapping
{
    private static readonly GuidSerializer GuidString = new(BsonType.String);

    public static void Register()
    {
        if (BsonClassMap.IsClassMapRegistered(typeof({{Entity}})))
            return;

        BsonClassMap.RegisterClassMap<{{Entity}}>(map =>
        {
            map.AutoMap();
            map.SetIgnoreExtraElements(true);
            map.MapIdMember(x => x.Id).SetSerializer(GuidString);
        });
    }
}
